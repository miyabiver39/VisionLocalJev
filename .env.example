# Camera Source: 0 (webcam), /dev/video0, rtsp://..., https://www.youtube.com/..., or synthetic
CAMERA_SOURCE=synthetic

# Vision Mode: detector (CPU Real CV) | mock | vlm
VISION_MODE=detector

# Decision Engine: diffusion-gemma-jev (DJev)
DECISION_ENGINE=diffusion-gemma-jev
# embedded: CPU emulator (no model inference)
# remote  : TypeSafe System One compatible server (TypeSafe Jev / imajev / Qev / Kev), POST /v1/systemone
#           Errors are reported as errors; there is no silent fallback to the emulator.
DJEV_MODE=embedded
DJEV_SERVER_URL=http://localhost:8765/v1/systemone
DJEV_MODEL=jev-latest               # e.g. jev-latest (TypeSafe), imajev-4b, qev:0.8b
DJEV_API_KEY=                       # sent as "Authorization: Bearer <key>" when set
DJEV_IMAGE_MODE=images              # images (imajev) | state_content (Qev) | none (TypeSafe Jev / Kev: text only)
DJEV_TIMEOUT=10                     # seconds

# imajev container (docker-compose.imajev-amd.yml / docker-compose.imajev-nvidia.yml)
# These override files set DJEV_MODE=remote and point the app at the imajev container automatically.
IMAJEV_SIZE=4b                      # 2b (~7GB VRAM) | 4b (~11GB) | 9b (~19GB)
IMAJEV_ROTATIONS=1                  # 1 = fastest | 4 = average over 4 option orders (~4x slower)
IMAJEV_PORT=8765                    # host port for the imajev API (bound to 127.0.0.1)

# Frame inference sampling rate per camera
SAMPLE_FPS=1.0

# Alert trigger confidence/score threshold (0.1 - 0.99)
ALERT_THRESHOLD=0.80

# External RAG Server (Optional, embedded SOP RAG runs by default if empty)
RAG_SERVER_URL=

# Web server port and host
PORT=8000
HOST=0.0.0.0

# Security (strongly recommended when the server is reachable from a network)
# When both are set, every page, API, camera feed and WebSocket requires HTTP Basic auth.
AUTH_USERNAME=
AUTH_PASSWORD=
# Max decoded size of images uploaded to Visual RAG (bytes, default 10MB)
MAX_UPLOAD_IMAGE_BYTES=10485760
